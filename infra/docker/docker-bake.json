{
  "group": {
    "default": {
      "targets": [
        "programmisto_admin_panel",
        "programmisto_auth",
        "programmisto_emulators"
      ]
    }
  },
  "target": {
    "programmisto_admin_panel": {
      "context": "frontend/admin-panel",
      "dockerfile": "Dockerfile",
      "tags": [
        "${DOCKER_REGISTRY}/programmisto_admin_panel:${IMAGE_TAG}"
      ],
      "platforms": [
        "${TARGET_PLATFORM}"
      ]
    },
    "programmisto_auth": {
      "context": "backend",
      "dockerfile": "auth/Dockerfile",
      "tags": [
        "${DOCKER_REGISTRY}/programmisto_auth:${IMAGE_TAG}"
      ],
      "platforms": [
        "${TARGET_PLATFORM}"
      ]
    },
    "programmisto_emulators": {
      "context": "backend/emulators",
      "dockerfile": "Dockerfile",
      "tags": [
        "${DOCKER_REGISTRY}/programmisto_emulators:${IMAGE_TAG}"
      ],
      "platforms": [
        "${TARGET_PLATFORM}"
      ]
    }
  },
  "variable": {
    "DOCKER_REGISTRY": {
      "default": "ghcr.io/programmisto"
    },
    "IMAGE_TAG": {
      "default": "latest"
    },
    "TARGET_PLATFORM": {
      "default": "linux/amd64"
    }
  }
}
