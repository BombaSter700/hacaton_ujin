# Copy to .env.prod on the VPS and replace CHANGE_ME values.
POSTGRES_USER=ujin
POSTGRES_DB=ujin
AUTH_DB_NAME=auth_db
INTEGRATION_DB_NAME=integration_db
POSTGRES_PASSWORD=CHANGE_ME
AUTH_DATABASE_URL=postgresql+psycopg2://ujin:CHANGE_ME@programmisto_postgres:5432/auth_db
INTEGRATION_DATABASE_URL=postgresql+psycopg2://ujin:CHANGE_ME@programmisto_postgres:5432/integration_db
REDIS_PASSWORD=CHANGE_ME
CLICKHOUSE_USER=ujin
CLICKHOUSE_DB=iot
CLICKHOUSE_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_BYTES
AUTH_DEBUG=false
INTEGRATION_DEBUG=false
AUTH_PORT=8001
INTEGRATION_PORT=8002
KRAKEND_PORT=8080
CORS_ORIGINS=[]
CORS_ALLOW_ORIGINS=[]
EMULATOR_INTERVAL=1
